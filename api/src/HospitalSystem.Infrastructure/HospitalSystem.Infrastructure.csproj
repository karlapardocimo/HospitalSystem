<Project Sdk="Microsoft.NET.Sdk">
  <!-- Infrastructure: MySQL (ADO.NET), hash de senha, geração de JWT e cache. -->
  <PropertyGroup>
    <RootNamespace>HospitalSystem.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HospitalSystem.Application\HospitalSystem.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="$(IdentityModelVersion)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Persistence\Scripts\*.sql" />
  </ItemGroup>
</Project>
