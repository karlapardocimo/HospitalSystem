# Copie para .env (o .env NÃO vai para o Git) e troque os valores.
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root
# Chave de assinatura do JWT: mínimo 32 caracteres, aleatória.
JWT_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
ADMIN_EMAIL=admin@hospital.local
ADMIN_SENHA=Admin@2026
# Senha dos usuários de demonstração (medico@, enfermagem@, recepcao@). Deixe vazio para não criar.
SENHA_USUARIOS_DEMO=Demo@2026
CRIAR_DADOS_DEMO=true
